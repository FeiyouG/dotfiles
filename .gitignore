# ignore packer compiled file
neovim/.config/nvim/plugin/

# Do not ignore any file with .gpg extension
!*.gpg

# Prevent accidental commit ggp keys
*.sec
*.pub

# ignore re-generable files
**/.DS_Store
**.log
.luarc.json

# opencode: secrets and generated plugin deps must never be committed
opencode/.config/opencode/secrets/
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package*.json
opencode/.config/opencode/bun.lock

# third-party binaries (not part of dotfiles)
bin/.local/share/bin/plannotator
